# ============================================================
# À placer dans le fichier .htaccess (Apache / LiteSpeed)
# ============================================================

# --- A) Sur grilvex.ma : forcer HTTPS + www (une seule version du site) ---
RewriteEngine On
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteRule ^(.*)$ https://www.zwawri-incorporation.com/$1 [R=301,L]


